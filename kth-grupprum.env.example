# Copy this file to kth-grupprum.env next to docker-compose.prod.yml on the
# server and fill in real values. kth-grupprum.env itself must never be
# committed (see .gitignore).

# --- Traefik routing (docker-compose.prod.yml) ---
REPO_TYPE=latest
TZ=Europe/Stockholm
DOMAIN_NAME=bibliotek.kth.se
# Must match the BASE_PATH build arg baked into the image at build time —
# see Dockerfile and next.config.ts. Include the leading slash, no trailing one.
PATHPREFIX=/grupprum

# --- Database (shared between kth-grupprum and kth-grupprum-db below) ---
DB_DATABASE=kth_grupprum
DB_USER=kth_grupprum
DB_PASSWORD=change-me

# --- App ---
# Comma-separated list of emails allowed to access /admin.
ADMIN_EMAILS=someone@kth.se
