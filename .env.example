# Copy to .env (both for local dev and, separately, in the server's deploy
# folder — same filename, different values in each place) and fill in.
# Read two different ways:
#   - Docker Compose loads it automatically for ${VAR} substitution in
#     docker-compose.yml / docker-compose-dev.yml (no --env-file flag
#     needed) — that's everything below except DATABASE_URL.
#   - Prisma/Next.js load it directly for anything run straight on your
#     machine (the Prisma CLI, `npx tsc`) — that's DATABASE_URL.
# .env itself must never be committed (see .gitignore).

TZ=Europe/Stockholm

# --- Database (shared between the app and db services in both compose files) ---
DB_DATABASE=bookingtools
DB_USER=bookingtools
DB_PASSWORD=change-me

# --- Traefik routing — only used by docker-compose.yml (production) ---
REPO_TYPE=latest
DOMAIN_NAME=bibliotek.kth.se
# Must match the BASE_PATH build arg baked into the production image at
# build time — see Dockerfile and next.config.ts. Leading slash, no
# trailing one.
PATHPREFIX=/bookingtools

# --- Host-side tooling only (Prisma CLI, tsc) ---
# Inside the Docker containers, DATABASE_URL is composed from
# DB_USER/DB_PASSWORD/DB_DATABASE above instead — see docker-compose*.yml.
# Port 5434 is the db service's port published to the host.
DATABASE_URL="postgresql://bookingtools:change-me@localhost:5434/bookingtools"
