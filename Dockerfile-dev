# Local dev image — used by docker-compose-dev.yml, not by production
# (see Dockerfile for that). Just installs dependencies; source is
# bind-mounted at runtime and the actual dev command (prisma generate +
# next dev) is set in docker-compose-dev.yml, not here, so editing the
# command doesn't require a rebuild.
#
# Pinned to the exact same Node patch as Dockerfile/.nvmrc/package.json's
# "engines" — see the comment in Dockerfile for why.
FROM node:22.23.2-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
