// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  bookings     Booking[]
  sessions     Session[]
  bookingHold  BookingHold?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id            String        @id @default(cuid())
  name          String
  building      String
  campus        String
  capacity      Int
  floor         String?
  hasScreen     Boolean       @default(false)
  hasWhiteboard Boolean       @default(false)
  bookings      Booking[]
  bookingHolds  BookingHold[]
}

model Settings {
  id                          String   @id @default("singleton")
  stepMinutes                 Int      @default(60)
  minMinutes                  Int      @default(60)
  maxMinutes                  Int      @default(120)
  scheduleLayout              String   @default("horizontal")
  requirePreliminaryConfirmation Boolean @default(false)
  confirmMinutesBefore        Int      @default(15)
  confirmMinutesAfter         Int      @default(15)
  updatedAt                   DateTime @updatedAt
}

model Booking {
  id          String    @id @default(cuid())
  roomId      String
  userId      String
  title       String
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([userId])
}

// A short-lived, advisory reservation created when a user opens the booking
// form for a free slot, so other clients can show "någon bokar..." instead
// of letting two people fill in the same slot at once. One per user (opening
// a new form / picking a different slot replaces it), renewed by a client
// heartbeat while the form stays open, and swept out lazily wherever
// bookings are read once `expiresAt` has passed — see
// releaseExpiredHolds() in src/lib/booking-hold.ts for why a background job
// isn't needed. This is purely a UX nicety: actual double-booking
// prevention still happens via the startTime/endTime overlap check against
// real Booking rows at creation time.
model BookingHold {
  id        String   @id @default(cuid())
  roomId    String
  userId    String   @unique
  startTime DateTime
  endTime   DateTime
  expiresAt DateTime
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
}
