// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  // Nullable: accounts created via KTH login (OIDC) never set a password.
  passwordHash String?
  // Entra ID's `sub` claim — stable identifier for a returning KTH-OIDC user,
  // independent of email (which is still the key used to link a KTH login to
  // a pre-existing email+password account of the same person).
  oidcSubject  String?       @unique
  // Cached result of KTH admin-group membership (see OIDC_ADMIN_GROUP_ID),
  // refreshed on every KTH login. Combined with ADMIN_EMAILS in isAdmin().
  isGroupAdmin Boolean       @default(false)
  createdAt    DateTime      @default(now())
  bookings     Booking[]
  sessions     Session[]
  bookingHold  BookingHold?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id            String        @id @default(cuid())
  name          String
  // Numeric sort key, independent of `name` (which is display text and not
  // guaranteed to sort correctly as a string — "10" sorts before "2").
  roomNumber    Int           @default(0)
  building      String
  campus        String
  capacity      Int
  floor         String?
  hasScreen     Boolean       @default(false)
  hasWhiteboard Boolean       @default(false)
  bookings      Booking[]
  bookingHolds  BookingHold[]
}

model Settings {
  id                          String   @id @default("singleton")
  stepMinutes                 Int      @default(60)
  minMinutes                  Int      @default(60)
  maxMinutes                  Int      @default(120)
  scheduleLayout              String   @default("horizontal")
  requirePreliminaryConfirmation Boolean @default(false)
  confirmMinutesBefore        Int      @default(15)
  confirmMinutesAfter         Int      @default(15)
  updatedAt                   DateTime @updatedAt
}

/**
 * One row per weekday (0 = Monday ... 6 = Sunday, matching getWeekDates in
 * src/lib/date.ts) so opening hours can differ by day — e.g. shorter hours
 * on weekends, or closed entirely. Always exactly 7 rows, seeded by the
 * add_opening_hours_per_weekday migration.
 */
model OpeningHours {
  weekday   Int     @id
  startHour Int     @default(8)
  endHour   Int     @default(20)
  closed    Boolean @default(false)
}

model Booking {
  id          String    @id @default(cuid())
  roomId      String
  userId      String
  title       String
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([userId])
}

// A short-lived, advisory reservation created when a user opens the booking
// form for a free slot, so other clients can show "någon bokar..." instead
// of letting two people fill in the same slot at once. One per user (opening
// a new form / picking a different slot replaces it), renewed by a client
// heartbeat while the form stays open, and swept out lazily wherever
// bookings are read once `expiresAt` has passed — see
// releaseExpiredHolds() in src/lib/booking-hold.ts for why a background job
// isn't needed. This is purely a UX nicety: actual double-booking
// prevention still happens via the startTime/endTime overlap check against
// real Booking rows at creation time.
model BookingHold {
  id        String   @id @default(cuid())
  roomId    String
  userId    String   @unique
  startTime DateTime
  endTime   DateTime
  expiresAt DateTime
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
}
