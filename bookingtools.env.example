# Copy this file to bookingtools.env next to docker-compose.yml on the
# server and fill in real values. bookingtools.env itself must never be
# committed (see .gitignore).

# --- Traefik routing (docker-compose.yml) ---
REPO_TYPE=latest
TZ=Europe/Stockholm
DOMAIN_NAME=bibliotek.kth.se
# Must match the BASE_PATH build arg baked into the image at build time —
# see Dockerfile and next.config.ts. Include the leading slash, no trailing one.
PATHPREFIX=/bookingtools

# --- Database (shared between bookingtools and bookingtools-db below) ---
DB_DATABASE=bookingtools
DB_USER=bookingtools
DB_PASSWORD=change-me

# --- App ---
# Comma-separated list of emails allowed to access /admin.
ADMIN_EMAILS=someone@kth.se
