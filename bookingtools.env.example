# Copy this file to bookingtools.env — both for local dev (next to
# docker-compose-dev.yml) and on the server (next to docker-compose.yml) —
# and fill in. Only vars injected into the app container via `env_file:`;
# everything Compose itself needs for ${VAR} substitution (DB credentials,
# Traefik routing, etc.) lives in .env instead — see .env.example.
# bookingtools.env itself must never be committed (see .gitignore).

# Must point at "bookingtools-db" (only resolves inside the Docker
# network) with the same user/password/database .env gives that service.
DATABASE_URL="postgresql://bookingtools:change-me@bookingtools-db:5432/bookingtools"

# Comma-separated list of emails allowed to access /admin.
ADMIN_EMAILS=someone@kth.se
