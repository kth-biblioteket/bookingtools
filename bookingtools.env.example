# Copy this file to bookingtools.env — both for local dev (next to
# docker-compose-dev.yml) and on the server (next to docker-compose.yml) —
# and fill in. Only vars injected into the app container via `env_file:`
# that aren't already composed by the compose file itself — DATABASE_URL,
# for instance, is built from .env's DB_USER/DB_PASSWORD/DB_DATABASE
# instead of being repeated here, so the db password exists in exactly one
# place. See .env.example for everything Compose itself needs.
# bookingtools.env itself must never be committed (see .gitignore).

# Comma-separated list of emails allowed to access /admin.
ADMIN_EMAILS=someone@kth.se

# --- KTH Login (OpenID Connect via Microsoft Entra ID) ---
# For now: client_id/secret of a reused, no-longer-used Entra app
# registration (its only redirect URI is https://apps.lib.kth.se/mrbs — see
# src/lib/oidc.ts). Replace with a dedicated app registration's values once
# KTH IT issues one; also add a localhost redirect URI to that registration
# at that time to enable local dev testing of this flow.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The KTH/Entra tenant's OIDC discovery issuer URL, e.g.
# https://login.microsoftonline.com/<tenant-id>/v2.0
# Leave unset to disable the "Log in with KTH" button entirely (it is
# hidden, not broken, when this is empty).
OIDC_ISSUER=

# Optional: Entra/KTH group object-id whose members are treated as admins
# in addition to ADMIN_EMAILS above. Leave empty to use ADMIN_EMAILS only.
OIDC_ADMIN_GROUP_ID=
