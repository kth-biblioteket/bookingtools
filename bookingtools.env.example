# Copy this file to bookingtools.env — both for local dev (next to
# docker-compose-dev.yml) and on the server (next to docker-compose.yml) —
# and fill in. Only vars injected into the app container via `env_file:`
# that aren't already composed by the compose file itself — DATABASE_URL,
# for instance, is built from .env's DB_USER/DB_PASSWORD/DB_DATABASE
# instead of being repeated here, so the db password exists in exactly one
# place. See .env.example for everything Compose itself needs.
# bookingtools.env itself must never be committed (see .gitignore).

# Comma-separated list of emails allowed to access /admin.
ADMIN_EMAILS=someone@kth.se

# --- KTH Login ---
# The actual ADFS/OIDC round trip is handled by the separate
# librarytools-auth service now (see the plan's Fas 1) — this app only
# verifies the short-lived identity token it issues, via its published JWKS.
# e.g. https://apps.lib.kth.se/mrbs/.well-known/jwks.json (or the ref
# equivalent). Leave unset to disable the "Log in with KTH" button entirely
# (it is hidden, not broken, when this is empty) — see src/proxy.ts.
KTH_AUTH_JWKS_URL=
